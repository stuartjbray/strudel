
setcpm(20)
$: stack(
  s("[sbd,bd:7]*4").speed(rand.range(1, 3)).late("0 .01 0 .01"),
  stack(
   n("[3 4 3 0 3 4 3 1]").scale("c4:major").s("gm_pad_warm").degradeBy(.3),
   n("[3 4 3 0 3 4 3 1]").scale("c5:major").s("gm_pad_warm").degradeBy(.3).late(.5),
  ).lpf(400).room(3).gain(.4),
  
  s("[brown pink white]").segment(8).degradeBy(.2).room(3).att(.8).rel(.8).late(irand(4).div(4)).gain(1.2).lpf(1500),
  n("1 _ <0 2> <-2 3 2>").s("xylophone_soft_ff").scale("c3:major").phaser(4).slow(2).gain(1).room(3),

  s("didgeridoo:<1 2 3 4 5 6 7>").fast(2),

  s("harmonica_soft").mask("<1 - - 1 - 1 - - - 1 ->").att(1).rel(1),
)