//@title afflict-the-comfortable
//@by Stuart Bray
//@url https://soundcloud.com/stuart-j-bray

setcpm(26)

// -------------- Drums
const drumsPass = (x) => x.color("white").bank("compurhythm1000");

var d1 = sound("[bd bd:2]*4").struct(  "1 - - 1 - - - -  1 - - 1 - - - -")
var d2 = sound("sd").struct(  "- - - - - - 1 -  - - - - - - - -").room("<0 .4>")
var d3 = sound("rim").struct( "- - - - 1 - - -  - 1 - - 1 - <- 1> <- 1>").gain(".2 .5 .3")
var d4 = sound("hh").struct(  "- - - - - - - -  - - 1 1 - 1 1 -")

var _drums_intro = drumsPass( s("[sd bd <- - - sd> bd]*4, hh!3 - hh!3 - hh!3 - - - - - ") )
var _drums_fill = s("<- - - [rim rim - rim rim - rim  sd ]>").speed("[1 1.05 1 1.05]")

var _drums1 =      drumsPass(stack(  d1,  d2,  d3,  d4, _drums_fill))   // normal
var _drums2 =      drumsPass(stack(  d1, d2  ))            // break down


// Define pass functions for each instrument
var chordsPass = (x) => n(x).scale("c4:major").sound("gm_electric_guitar_muted").color("red").phaser(1).gain(1)
var bassPass =   (x) => n(x).scale("c3:major").sound("sine").color("orange").clip(.5).gain(.5).rel(.2)
var leadPass =   (x) => n(x).scale("c3:major").sound("gm_koto:[1 2]").color("yellow")
var guitPass =   (x) => n(x).scale("c3:major").sound("gm_distortion_guitar").color("green")
var budPass =   (x) => n(x).scale("c3:major").sound("gm_acoustic_bass").color("cyan").distort(3).gain(.1).phaser(1)
var pianPass=   (x) => n(x).scale("c4:major").sound("piano").color("blue").clip(.4).rel(.4).gain(.8)


var str1 = "- [0 1 2 1] _ - [0 1 2 <1 ->] _ - <[0 1] -> "
var _c =   `<
 [0,1#,4] [-3#,0,1#] [-3,-2#,1] [-4,-2,0]
 [0,1#,4] [1#,4,5#] [4,5#,8] [3,5,7]
>`
var _chords1 = chordsPass(_c).arp(str1)
var _chords2 = chordsPass(`<
-
>`)

var _bass1 = bassPass(_c).arp("0 0 1 0 - <0 -> <2 -> <0 ->").trans("0,12")
var _bass2 = bassPass(`<
-
>`)

var _lead1 = leadPass(`<
 7 - - [[5,7] 8 _ - 7 5# _ -]
 7 - - [[5,7] 8 _ - 8# _ - -]
>`)
var _lead2 = leadPass(`<
-
>`)

var _guit1 = guitPass(`<
 0 - 3 - 1# - 4 -
>`).att(.5).rel(1)

var _bud1 = budPass(`<
 [- 0 1 -][- 1# <3 1> - ]
>`)


var _pian1 = pianPass(`<
 [0 0 - - 1# 0 - - ]
 [0 0 - 0 <3 1#> _ <- 4> _ ]
>`).trans(-24)

var _pian2 = pianPass(`<
 [4 - 3 1# 3 1# - 3   - 1# - 0 -@4]
 [3 - 3 1# 3 1# - <4 0>   - - - -  - - - - ]
>`)

var M = 1;
// M = 0;
$: arrange(
  [M*1, _drums_intro,
  ],
  [M*4, stack(    
    _drums1,
    _bass1,    _chords1, 
  )],
  [M*8, stack(    
    _drums1,
    _chords1,     _bass1,    _lead1,    _guit1,
  )],
  [M*8, stack(
    _drums1,
    _chords1,     _bass1,    _lead1,    _guit1,    _bud1, _pian1,
  )],
  [1*8, stack(
    _drums1,
    // _chords1,    //    _guit1,
    _bass1,    _lead1,
    _bud1,    _bud1.late(1/2).trans(12),
    _pian1,    _pian2,
  )],
  ).punchcard()
  