
setCpm(60)

var _d1 = stack(
  s("[bd - sd -][[- rim:3] bd*2 <sd -> bd:3]").slow(2),
  s("<- - - [oh - oh*2 -]>"),
  s("hh*8").gain(".3 .8 .3"),
)
var _d2 = stack(
  s("[bd bd:3 bd:2 bd]"),
  s("<[oh - oh*2 -]>"),
)
var _d3 = s("hh hh*2 <- oh> -")


var dSawPass = (x) => stack(
 n(x).s("saw").fm(2).fmh(3).lpf(500),
 n(x).s("saw").rel(.5).gain(.3).hpf(1000),
).scale("c3:major")
var pPass = (x) => n(x).s("gm_electric_bass_finger").scale("c4:major")

var _saw1 = dSawPass(`<
 [1 1 1 1 1 - 1 -][1 - 1 - 1 2 3 4]
>`)
var _saw2 = dSawPass(`<
 [3 - - 2 - - 4 -][3 2 1 - 5 - <5 5#> -]
>`).trans(12)
var _saw3 = dSawPass(`<
 5 5# <4 7> 5
>`).trans(-12)
var _saw4 = dSawPass(`<
 5 <4 5#> 3 2
>`).trans(12)
var _saw5 = dSawPass(`<
 [- 5 4 3 2 - 2 3]
 [4 3 2 4 3 2 1 0]
 [- 5 4 3 2 - 2 1]
 [5 4 3 2 - - - -]
>`).trans(12).fm(6)
var _saw6 = dSawPass(`<
 [- 3 2 1 4 3 2 1]
 [- 5 4 3 5# 5 4 3]
>`)

var _p1 = pPass(`<
 [1,3,5] [1,4,5] [1,2,5] [1,3,5]
 [1,3,5] [0,2,5] [0,2,4] [1,3,5]
>`).struct("[1 - - 1][- 1 1 -]").mask("<1 1 1 [- 1 - 1]>")

var _bass1 = pPass(`<
 [1 - <3 4> 1] [- [- -2] <0 1> [- 0] ]
>`).trans(-12).cubic(.8)

var M = 0
$: arrange(
  [M*2, stack(    _saw1  )],
  [M*8, stack(    _d1,    _saw1,    _saw2,    _saw3,  )],
  [M*8, stack(    _d1,    _saw1,    _saw3, _saw4, _saw5  )],
  [M*8, stack(
    _d1.ply("1 2"),
    _saw1, _saw3.trans(12), _saw4.trans(12), _saw5.trans(-24)
  )],
  [M*8, stack(
    _d1.rev().hpf(1000),
    _saw1, _saw3.phaser(8).gain(.4), _saw4, _saw6,
    _bass1.clip(.4).mask("[1 - - 1]")
  )], 
  [M*8, stack(
    _d1, _saw1,_saw3.gain(.4), _saw4.trans(-12),     _p1, _bass1.clip(.4).ply(2)
  )], 
  [M*16, stack(
    _d1, _d2, 
    _saw1.room(2).gain("[.2 .4 .6 1]/16"),
    _saw1.trans(12).gain("[0 .2 .4 [.8 0]]/16").late(1/8),
  )], 
  [M*8, stack(    _d1.bank("mc303"),    _saw1,    _saw2,    _saw3,  )],
  [M*8, stack(    _d1.bank("mc303"),    _saw1,    _saw3, _saw4, _saw5  )],
  [1*8, stack(
    _d2, _d3,
    _saw2,
    _saw2.late(1/4).trans(12),
  )], 
  [1*8, stack(    _d1.bank("mc303"), _d2,    _saw1,    _saw3, _saw4, _saw5  )],
  [1*8, stack(
    _d2, _p1.trans(12), _bass1.lpf(400)
  )], 
)