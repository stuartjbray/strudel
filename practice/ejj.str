//@title ejj
//@by Stuart Bray
//@url https://soundcloud.com/stuart-j-bray

setcpm(35)

// -------------- Drums
const drumsPass = (x) => x.color("white");

var d1 = sound("ddr30_bd, sakatadpm48_bd").struct(    "1 - - - - - - -   - - - - - - - -").room(0).echo(6,1/16,.6).postgain(.5)
var d2 = sound("rolandd70_sd").struct(   "- - - - - - - -   <- 1> - - - - - - -").echo(6,1/8,.5).postgain(.6)
var d3 = sound("lm1_hh").struct(         "- - - - - - - -   - - - -   - - - -").gain(.3)
var d4 = sound("ry30_hh").struct(        "1 - - - 1 - - -   1 - - -   1 - - -").gain(.2)

var _drums_intro = drumsPass(stack(  
 s("rolandd70_sd").echo(16,1/4,.8).mask("<1 0 0 0>")
))            
var _drums1 =      drumsPass(stack(  d1, d2  ))   // normal
var _drums2 =      drumsPass(stack(  d1, d2  ))            // break down


// Define pass functions for each instrument
window.cols = ["#ff0000","#ff8700","#ffd300","#deff0a","#a1ff0a","#0aff99","#0aefff","#147df5","#580aff","#be0aff"]
var chordsPass = (x) => n(x).scale("c3:major").sound("piano").color(cols[0]).postgain(1.3)
var bassPass =   (x) => n(x).scale("c3:major").sound("gm_reed_organ:3").color(cols[1]).att(.6).rel(.5).gain(.6)
var leadPass =   (x) => n(x).scale("c3:major").sound("gm_electric_guitar_muted:5").color(cols[2]).gain(1.3).rel(.5)
var bethPass =   (x) => n(x).scale("c3:major").sound("gm_blown_bottle:2").color(cols[3]).gain(1).att(.4).rel(.4)
var wooPass =    (x) => n(x).scale("c3:major").sound("gm_fx_echoes").color(cols[4]).rel(2).cubic(.2)


  

// Apply pass functions to patterns
var _chords1 = chordsPass(`<
 [5 1 3 5 1 3 5 1] [5# 1 5 1 4 1 3 1]
 [5 0# 3 5 0# 3 5 0#] [5# 0# 5 0# 4 0# 3 0#]
 [5 0 3 5 0 3 5 0] [5# 0 5 0 4 0 3 0]
 [5 -1 3 5 -1 3 5 -1] [4 - - -]
>`).gain("2 1 1 2 1@4")
var _chords1End = chordsPass(`<
 -@7
 [-6 -5 -4 -3 -5 -4 -3 -2   -4 -3 -2 -2# -3 -2 -2# 0]
>`).trans(12)

var _chords3 = chordsPass(`<
 [3 -2# 1 3 -2# 1 3 -2#] [4 -2# 3 -2# 2 -2# 3 -2#]
 [3 -1 1 3 -1 1 3 -1] [4 -1 3 -1 2 -1 3 -1]
 [4 0 2 4 0 2 4 0] [5 0 4 0 3 0 2 0]
 [4 0# 2 4 0# 2 4 0] [5 - - -] 
>`)

var _chords4 = chordsPass(`<
 [1 3 5 1 3 5 1 3]
>`)

var _bass1 = bassPass(`<
 [1 _ - 3 0# _ _ -] [0 _ - 3 -1 _ _ -]
>/4`)
var _bass2 = bassPass(`<
 -2# -1 0 0#
>/2`)

var _lead1 = leadPass(`<
 [3 2 3 4 3 4 5 4] [5 5# 5 4 5 4 3 4]
>`)
var _lead2 = leadPass(`<
 [5 _ _ [4 3]][ 2 _ _ 1] 4 [5 _ 4 3]
 [3 4 _ [3 4]] [5 _ _ _] [1 5 _ 4] [2 _ 3 4]
>`)

var _lead3 = leadPass(`<
 [5# 5 4 3 5 4 3 2] [0 1 2 3 4 5 4 3]
>`)
var _lead4 = leadPass(`<
 [5 _ _ [5# 5]][ 4 _ _ 1] 3 [2 _ 3 4]
 [3 2 _ [4 3]] [2 _ _ _] [2 3 _ 4] [5 _ 5 4]
>`)

var _beth1 = bethPass(`<
 [1,3,5] _
>`).trans(-12)

var _woo_intro = wooPass(`<
 [[1 1 1 1], [- - 3 3]]
 [[1 1 1 1], [3 3 3 3], [5 5 5 5], [- - 7 7]]
 [1,3,5#]@2
>`)
var _woo1 = wooPass(`<
 [1,5] [3,[5 7]] [0,[2 3]] [-1,[4 5]]
>/2`).trans(12).gain(.4)
var _woo2 = wooPass(`<
 [-2#,3] [-1,[2 3]] [0,[4 5]] [1,[5 4]]
>/2`).trans(12).gain(.4)
var _woo4 = wooPass(`<
 [1,3,<5 5 5# 5# 7 7 5# 5#>]
>`)


var M = 1
// M = 0
$: arrange(
  // Change 1 to be M to conditionally mute this stack.
  [M*2, stack(
    _drums1,    _woo_intro,    _beth1,
  )],
  [M*8, stack(    // Dm descending
    _drums1,    _chords1,     _chords1End,     _bass1,
  )],
  [M*8, stack(
    _drums1,    _chords1End,     _chords1,    _bass1,    _lead1,
  )],
  [M*8, stack(    
    _drums1, _woo1, _chords1,     _bass1, 
    _lead1.gain(.6),    _lead2.trans(12),
  )],
  [M*8, stack( // now go up...
    _drums1, _woo2, _chords3,    _bass2,   
    _lead3.gain(.6),   _lead4.trans(12),
  )],
  [1*8, stack( // stay on Dm
    _drums1, 
    _woo4,
    _chords4,
    // _bass2,       _lead3.gain(.6),   _lead4.trans(12),
  )],
).punchcard() 