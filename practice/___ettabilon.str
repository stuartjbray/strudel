//@title ettabilon
//@by Stuart Bray
//@url https://soundcloud.com/stuart-j-bray

setCpm(60)

var drumPass = (x) => x.color("white")
var _d1 = drumPass(stack(
  s("[bd - sd -][[- rim:3] bd*2 <sd -> bd:3]").slow(2),
  s("<- - - [oh - oh*2 -]>"),
  s("hh*8").gain(".3 .8 .3"),
))
var _d2 = drumPass(stack(
  s("[bd bd:3 bd:2 bd]"),
  s("<[oh - oh*2 -]>"),
))
var _d3 = drumPass(s("hh hh*2 <- oh> -"))
var _d4 = drumPass(s("bd:2!4, [- [cr!4]]").speed(.5))
var _d5 = drumPass(s("bd, cr, cr:2"))


var dSawPass = (x) => stack(
 n(x).s("saw").fm(2).fmh(3).lpf(500),
 n(x).s("saw").rel(.5).gain(.3).hpf(1000),
).scale("c3:major").color("red")
var dSawPass2 = (x) => stack(
 n(x).s("saw").fm("<1 2 3 4>").fmh("<3 2 1>").lpf(800),
).scale("c3:major").color("blue")
var dSawPass3 = (x) => stack(
 n(x).s("saw").fm("<4 6 8>").clip(.2).rel(.2).cubic(1).hpf(800).phaser(3),
).scale("c3:major").color("blue")

var pPass = (x) => n(x).s("gm_electric_bass_finger").scale("c4:major").color("orange")
var ePass = (x) => n(x).s("gm_clavinet").scale("c4:major").color("yellow")
var gPass = (x) => n(x).s("gm_distortion_guitar").scale("c3:major").color("green")
var vPass = (x) => n(x).s("gm_lead_7_fifths").scale("c3:major").color("cyan")


var arp1 = "<[ 1 _ -    <1 -> _ _ - - ]!7 [- 1]>"
var _saw1 = dSawPass(`<
 [1 1 1 1 1 - 1 -][1 - 1 - 1 2 3 4]
>`)
var _saw2 = dSawPass(`<
 [3 - - 2 - - 4 -][3 2 1 - 5 - <5 5#> -]
>`).trans(12)
var __s3 = `<
 -2 -2# -3   -2 
 -2 -2# -3   1
 -2 -2# 0    -2 
 -2 -2# 0    1
>`
var _saw3 = stack(  dSawPass2(__s3).arp(arp1),  dSawPass3(__s3).arp(arp1).echo(3,1/8,.6))

var _saw4 = dSawPass(`<
 5 <4 5#> 3 2
>`).trans(12).arp("<[1 -] [1 - 1 - 1 - 1 -]>")
var _saw5 = dSawPass(`<
 [- 5 4 3 2 - 2 3]
 [4 3 2 4 3 2 1 0]
 [- 5 4 3 2 - 2 1]
 [5 4 3 2 - - - -]
>`).trans(12).fm(6)
var _saw6 = dSawPass(`<
 [- 3 2 1 4 3 2 1]
 [- 5 4 3 5# 5 4 3]
>`)

var _p1 = pPass(`<
 [1,3,5] [1,4,5] [1,2,5] [1,3,5]
 [1,3,5] [0,2,5] [0,2,4] [1,3,5]
>`).struct("[1 - - 1][- 1 1 -]").mask("<1 1 1 [- 1 - 1]>")

var _bass1 = pPass(`<
 [1 - <3 4> 1] [- [- -2] <0 1> [- 0] ]
>`).trans(-12).cubic(.8)

var _e1 = ePass(`<
 [- - [1,3] - - [1,3] - -] [ [0,4] - - [0,4] - - - -]
 [- - [0,2] - - [0,2] - -] [ [0,3] - - [0,3] - - - -]
 - [- 3 - 2]
 [[1,3,5] - [1,4,5#] -] [[0,3,5] - [0,2,4] -]
>`)
var _e2 = ePass(`<
 [1 - 3 - 5 - 0 -] [- - - - 3 - 2 -]
 [-2# - 1 - 5 - 4 -] [- - - - 3 - 2 -]
 [1 - 3 - 5 - 5# -] [- - - - 5 - 4 -]
 [-2# - 1 - 3 - 4 -] [4# - 4 - 3 - 2 -]
>`)
var _g1 = gPass(`<
 1 0 1 2
>`).arp(`<[1 [- 1] - -]!3 [1 <1 ->]>`)

var _v1 = vPass(`<
 [1 2 3 2]
>`)

var M = 1
$: arrange(
  [M*2, stack(    _saw1  )],
  [M*8, stack(    _d1,    _saw1,    _saw2,    _saw3,  )],
  [M*8, stack(    _d1,    _saw1,    _saw3.trans(12).gain(.5), _saw4, _saw5  )],
  [M*8, stack(
    _d1.ply("1 2"),
    _e2,
    _saw1, _saw4.trans(12), _saw5.trans(-24)
  )],
  [M*8, stack(
    _d1.rev().hpf(1000),
    _saw1, _saw3.phaser(8).gain(.4), _saw4, _saw6,
    _bass1.clip(.4).mask("[1 - - 1]")
  )], 
  [M*8, stack(
    _d1, _saw1,_saw3.gain(.2), _saw4.trans(-12),     _p1, _bass1.clip(.4).ply(2)
  )], 
  [M*16, stack( // gradual build up.
    _d1, _d2, 
    _saw1.room(2).gain("[.2 .4 .6 .8]/16"),
    _saw1.trans(12).gain("[0 .2 .4 [.6 0]]/16").late(1/8),
    _saw5.mask("[1 -]").trans(-12),
  )], 
  [M*8, stack(    _d1.bank("mc303"),    _saw1,    _saw2,    _saw3.gain(.4),  _e1, )],
  [M*8, stack(    _d1.bank("mc303"),    _saw1,    _saw3.gain(.4), _saw4, _saw5, _e1,  )],
  [M*8, stack(
    _d2, _d3,
    _saw2,
    _saw2.late(1/4).trans(12),
  )], 
  [1*8, stack(    _d1.bank("mc303"), _d2,    _saw1,                      _saw4, _saw5, _g1,  
                  _saw3.clip(.1), _saw3.clip(.1).trans(12).late(1/4).gain(.2), 
             )],
  [1*8, stack( // happy
    _d2, _p1.trans(12), _bass1.lpf(400), _e2, _g1,
  )], 
  [1*8, stack( 
    _d2, _p1.trans(0), _bass1.lpf(400), _e2.trans(-12).gain(1.2), _g1.trans(12),
    _saw1
  )], 
  [1*8, stack(
    _d1, _d2, _d3,
    _saw2,
    _saw2.late(1/4).trans(12),
    _saw5,
    _e1, _g1.trans(12),
    _v1,
  )], 
  [1*8, stack(
    _d1, _d2.ply(2),
    _saw5.mask("[0 1]!4").trans(-12).cubic(.8),
    _saw5.mask("[1 0]!4").trans(0).cubic(.4),
    _v1, 
    _v1.trans(12).mask("<0 1 0 1>"),
    _v1.trans(24).mask("<0 0 0 1>"),
  )], 
  [1*4, stack(
    _d1, _d2.ply(2), _d4,
  )], 
  [1*1, stack(
    _d5,
  )], 
  [1*4, stack(
    silence
  )], 
  
).punchcard()


