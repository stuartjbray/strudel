

var ch1 = `<3 7 4# 5#>`
var ch2 = `<
 [3 _ _ 4# _ 3 5# _ 7 _ _ -]
 [3 _ _ 4# _ 3 6 _ 5# 4# _ -]
 [3 _ _ 4# _ 3 5# _ 7 _ _ -]
 [8# _ _ 8# - 7 8# _ 10 _ _ - ]
>`


$: stack(
  s("<[oh - hh [- hh] oh - hh [- hh]] >").speed("1 .94"),
  s("[bd [- - - bd]] bd:3"),
  n(ch1).scale("c2:major").sound("steinway"),
  n(ch2).scale("c3:major").sound("piano")
)