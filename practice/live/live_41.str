// lets goooooooooooooooooooooooooooooooooooooo

setcpm(34)
$: stack(
  // s("sbd*4"),
  s("bd rim [- bd] [rim , sd]"),
  s("<- - - [ bd(5,8), cr]>"),
  s("hh*8").gain(".3 .6 .3")
)
 .sometimes(x => x.ply(2))
 .sometimes(x => x.clip(.2))
var _t = `< 
 [0 7 7 0 - <4 5 6 5> 3 2]
 [0 3 5 - 2 1 0 3 ]
>`
$:stack(
  n(_t).scale("c3:major").s("saw").fm(irand(6)).fmh(irand(6)).trans(0).late(0),
  n(_t).scale("c3:major").s("saw").fm(irand(6)).fmh(irand(6)).trans(12).late(0.25),
  n(_t).scale("c3:major").s("saw").fm(irand(6)).fmh(irand(6)).trans(24).late(0.5),
  n(_t).scale("c3:major").s("saw").fm(irand(6)).fmh(irand(6)).trans(36).late(0.75),
)
 .sometimes(x => x.ply(2))
 .sometimes(x => x.clip(.2).rel(.3))
 .gain(1.2)
 // .sometimesBy(.9, x => x.gain(.1))
 // .mask("<1 1 - - - 1 - 1 ->")

var _c = `<Am C F G>`
$: stack(
  chord(_c).voicing().phaser(2),
  chord(_c).voicing().s("piano").arp("<[0 1 2 3 4 5 6 7]>"),
  chord(_c).voicing().s("steinway").arp("<[0 1 2 3]>"),
  chord(_c).voicing().s("gm_electric_guitar_clean").arp("<[0 - - 1 - - <1 -> -]>").distort(1.2).trans(-12),
)
