setcpm(40)
$:s("sbd*4").distort(2)
$:stack(
  s("bd [- bd - -]"),
  s("<- - - [bd*4]>"),
  s("- rim - rim"),
  s("hh*8").gain(".3 .7 .3")
).bank("compurhythm1000")
 .sometimes(x => x.ply(2))
 .sometimes(x => x.clip(.1))
 .sometimes(x => x.lpf(500))
var _t = `<
 [0 7 7 0 - <4 5 6 4> 1 3]
>`
$:stack(
  n(_t).scale("c2:major").s("saw").fm("0 2").fmh("<1 2 3>"),
  n(_t).scale("c3:major").s("saw").fm("0 2").fmh("<1 2 3>").late(1/4),
  n(_t).scale("c4:major").s("saw").fm("0 2").fmh("<1 2 3>").late(2/4),
  n(_t).scale("c5:major").s("saw").fm("0 2").fmh("<1 2 3>").late(3/4),
)//.gain(.5)
 .sometimes(x => x.ply(2))
 .sometimes(x => x.clip(.2))
 .sometimes(x => x.mask("- 1 1 -"))

var _c = `<Am C F G>`
$:stack(
  chord(_c).voicing(),
  chord(_c).voicing().s("gm_acoustic_guitar_steel")   .arp("[0 1 2 3 4 5 6 7]").gain(2),
  chord(_c).voicing().s("gm_acoustic_guitar_steel")   .arp("[0 1 2 3]").trans(12).ply(2).gain("1.7 1.3 .3"),
  chord(_c).voicing().s("gm_guitar_harmonics")   .arp("<- [[0,1,2] 0 1 0]>").gain(2),
  chord(_c).voicing().s("gm_guitar_harmonics")   .arp("< [[0,1,2] 3 1 [0,2]] ->").gain(2).trans(-12),
)//.lpf(500)
 // .clip(.9).ply(4).gain(1.4)
//all(x => x.hpf(5000))