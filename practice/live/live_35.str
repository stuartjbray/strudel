setcpm(36)

$: s("sbd*4")
$: stack(
  s("bd [- bd - -]"),
  s("- rim - rim"),
  s("<- - - [sd sd sd sd ]>"),
  s("hh*8").gain(".3 .6 .3")
).bank("compurhythm1000")
 // .sometimes(x => x.lpf(500))
var _t = `<
 [0 0 <7 8 9 8> 3 4 - 1 2]
 [7 6 0 - 7 - 1 2]
>`
$: stack(
  n(_t).scale("c2:major").s("gm_electric_guitar_clean"),
  n(_t).scale("c3:major").s("gm_acoustic_guitar_steel").late(1/4),
  n(_t).scale("c4:major").s("gm_electric_guitar_clean").late(2/4),
  n(_t).scale("c5:major").s("gm_acoustic_guitar_steel").late(3/4),
)
 .sometimes(x => x.ply(2))
 .sometimes(x => x.phaser(2))
 .sometimes(x => x.clip(.2))
var _c = `<Am C F G>`
$: stack(
  chord(_c).voicing().s("sqr")  .arp("[0 1 2 3]")
  .ply(2).fm("2 0").fmh("<1 2 3>").rel(2).trans(-12),
  
  chord(_c).voicing().s("piano")  .arp("[0 1 2 3 4 5 6 7]").gain(.5),
  chord(_c).voicing().s("gm_lead_3_calliope")  .arp("0 1 2 3"),
  
)
  //.lpf(1500)
// all(x => x.hpf(8000))