setcpm(34)
$:s ("sbd*4")
$: stack(
  s("bd [- bd - -]"),
  s("<- - -[bd bd bd bd]>"),
  s("- sd"),
  s("- rim - rim"),
  s("hh*8").gain(".3 .6 .1")
).bank("compurhythm1000")
 .sometimes(x => x.ply(2))
 .sometimes(x => x.lpf(800))
var _t = `0 7 <7 8 9 8> 0 - 4 5 0`
$: stack(
  n(_t).scale("c3:major").s("saw").fm("0 2").fmh("<1 2 3>"),
  n(_t).scale("c4:major").s("saw").fm("0 2").fmh("<1 2 3>").late(1/4).mask("<1 - 1 1>"),
  n(_t).scale("c5:major").s("saw").fm("0 2").fmh("<1 2 3>").late(2/4).mask("<- 1 1 >"),
  n(_t).scale("c6:major").s("saw").fm("0 2").fmh("<1 2 3>").late(3/4).gain(.4).mask("<1 - 1>"),
)
 .sometimes(x => x.ply(2))
 .sometimes(x => x.trans(-12))
 .sometimes(x => x.lpf(500))
 .gain(.2)
var _c = `<Am C F G>`
$: stack(
  chord(_c).voicing().s("steinway")   .arp("[0, 1, 2] 3 4 5").gain(.4),
  chord(_c).voicing().s("gm_acoustic_guitar_steel")   .arp("[0 1 2 3 4 5 6 7 ]"),
  chord(_c).voicing().s("gm_acoustic_guitar_steel")   .arp("[0 1 2 3 ]").rel(2).trans(12)
   .sometimes(x => x.ply(2)),
 chord(_c).voicing().s("supersaw").arp(0).gain(1.3).trans(12),
 chord(_c).voicing().s("supersaw").arp("0 1 0 1 0 1").gain(1.3).trans(-24).struct("1 - 1 - 1 1 - 1").gain(2).ply(2)
)//.gain(1)
// all(x => x.hpf(5000))