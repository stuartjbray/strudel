//@title skidmarxism
//@by Stuart Bray
//@url https://soundcloud.com/stuart-j-bray

setcpm(32)

// -------------- Drums
const drumsPass = (x) => x.color("white");

var d1 = sound("sbd, bd").struct(  "<0 0 0 1>".pick([
  "1 - - - 1 - - -  1 - - 1 - - 1 -".gain("1 3 1"),
  "1 - 1 - - - - -  1 - 1 - - - - -"  
]))
var d1x = sound("sbd, bd").struct(  "<0 - 0 1>".pick([
  "1 - - - 1 - - -  1 - - 1 - - 1 -",
  "1 - 1 - - - - -  1 - 1 - - - - -"  
]))
var d2 = sound("sd").struct(  "<0 0 0 1>".pick([
  "- - - - 1 - - -  - - - 1 - - - -".gain("1 3 1"),
  "- - - - 1 1 - -  - - - - 1 - 1 -"  
]))
var d2x = sound("sd").struct(  "<0 - 0 1>".pick([
  "1 - - 1 - - 1 -  - - - 1 - - 1 -".gain("1 3 1"),
  "- 1 - - 1 1 - -  - - 1 - 1 - 1 -"  
]))

var d3 = sound("hh").struct(  "- - 1 - - - - -  - 1 - 1 - 1 - -")
var d4 = sound("cr").struct(  "- - - - 1 - - -  - - - - 1 - - -").speed("1 1.1").clip("4 2")

var _drums_intro = drumsPass(stack(  d1, d2  ))            // build up
var _drums1 =      drumsPass(stack(  d1,  d2,  d3,  d4))   // normal
var _drums2 =      drumsPass(stack(  d1x, d2x  ))            // break down


// Define pass functions for each instrument
var chordsPass = (x) => n(x).scale("c3:major").sound("piano").color("red").gain(2)
var bassPass =   (x) => n(x).scale("c3:major").sound("gm_acoustic_guitar_steel").color("orange").cubic(1.2)
var leadPass =   (x) => n(x).scale("c4:major").sound("steinway").color("yellow")

// all(x => x.late("[0 0.04]*4"))

// Apply pass functions to patterns
var _chords1 = chordsPass(`<
 [0 2 4 2 0 - - -]
 [0 3 5 3 0 - - -]
 [0 4 5# 4 0 - - -]
 [0 3 5 3 0 - - -]
>`)
var _chords1a = chordsPass(`<
 [0 - - [4,5#] [4,5#] 0 [4,5#] _]
 [[3,5] - - - - - - -]
 [0 - - [3,5] [3,5#] - [3,5] -]
 [[2,4] - - - - - - -]
>`)
var _chords2 = chordsPass(`<
 [-3# 0 1# 0 -3# - - -]
 [-3 -2# 1# 2 1# - - -]
 [-4 -2 0 -2 -4 - - -]
 [-4 -1 0 -1 -4 - - -]
>`)

var _bass0 = stack(
  bassPass(`< [-3*16] [ -3 -2# 0 - 2*2 0 -2# 0] >`).postgain(sine.range(1,2).fast(2)) .clip("<[.3 .4 .5 .6 .7 .8 .9 1] 1>") .pan(0),
  bassPass(`< [-3*16] [ -3 -2# 0 - 2*2 0 -2# 0] >`).postgain(sine.range(2,1).fast(2)) .clip("<[1 .9 .8 .7 .6 .5 .4 .3] 1>") .pan(1)
  )
var _bass1 = bassPass(`<
 [ -3 -2# 0 - <<1# 2> -> 0 -2# 0]
>`).postgain("1 2 1")
var _bass2 = bassPass(`<
 [1# 1 0 3 _ _ 1# 3]
 [4 3 1#   [- -3@4]@5]
 [1# 1 0 3 _ - 1# 3]
 [4 3 1# -2 4# 4 1# 0]
>`).postgain("1 2 1")
var _bass3 = bassPass(`<
 [-]
>`)


var _lead1 = leadPass(`<
 - - [- - - 5# 5# <5 7> 5 -] -
>`)
var _lead2 = leadPass(`<
[- - - - - 3 4 <3 4#>] - - -
>`)

var M = 1;
// M = 0;
$: arrange(
  [M*2, stack(    
    _bass0,
  )],
  [M*8, stack(    
    _drums1,
    _chords1, 
    _bass1,
    _lead1,
  )],
  [M*8, stack(
    _drums1,
    _chords2,
    _bass2,
    _lead2,
  )],
  [M*8, stack(    
    _drums1,
    _chords1a, 
    _bass1,
    _bass1.trans(12).late(.5).rev(),
  )],
  [1*8, stack(
    _drums2,
  )],
  ).punchcard()
  