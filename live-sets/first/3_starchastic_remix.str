//@title Starchastic
//@by Stuart Bray
//@url https://soundcloud.com/stuart-j-bray
setcpm(40)
// Library
var m2 = "<- 1>"; var m_2 = "<1 ->"; var m4 = "<- - - 1>"; var m_4 = "<1 1 1 ->"

// -------------- Drums
const drumsPass = (x) => x.color("white");

var d1 = sound("sbd").struct(  "1 1 - 1 - - - -")
var d2 = sound("sd").struct( "1 - - - - - - -").room(.3)
var d1x = sound("sbd").struct( "1 - 1 - 1 - 1 - ")
var d2x = sound("sd").struct( "1 - - - 1 - - -")
var d3 = sound("hh").struct(  "- 1 - 1 - 1 - -")
var d4 = sound("rolandd70_sd").struct(  "- 1 - 1 - 1 - 1").mask(m4)
var d5= sound("rolandcompurhythm1000_sd").struct("1 1 [- 1] 1")
var d2xx = sound("linn9000_sd").struct("- 1 1 - 1 1 - 1").mask("m_4")
var d6 = sound("akaixr10_cr").struct("<- 1 - 1>").gain(.4)
var d7 = s("rm50_sd").struct("[- 1]*4").gain("<.2 .3 .4 .5 .6 .7 .8 .9>")

var _drums_intro = drumsPass(stack(  d1, d2, d6 ))            // build up
var _drums1 =      drumsPass(stack(  d1x,  d2x,  d3,  d4, d5)).gain(.7)  // normal
var _drums2 =      drumsPass(stack(  d1, d2, d6  ))           // break down
var _drums3 =      drumsPass(stack(  d1, d2, d7,  d2xx.mask("<0@3 1>")  ))           

var _drums_outro = drumsPass( s("bd,sd,cr").struct("<[1 1 1 - - - - -][- - - - 1 1 1 -]>") )


$: stack(
  // _drums1,
  // _drums2,
  //_drums3,
)



// Define pass functions for each instrument
var chordsPass = (x) => n(x).scale("c4:major").sound("steinway").color("red").gain(.7) //.phaser(8)
var bassPass = (x)   => n(x).scale("c2:major").sound("gm_electric_bass_pick").color("orange").gain(1.3)
var bbassPass = (x)   => n(x).scale("c3:major").sound("gm_electric_bass_pick:2").color("green").room(1.4).gain(1.3)
var leadPass = (x)   => n(x).scale("c4:major").sound("gm_koto, saw").color("yellow").gain(.7).attack(0).release(.8).sustain(.4).distort(1.2)
var wissPass = (x)   => n(x).scale("c4:major").sound("sine ").color("blue").gain(.7).fm(2).fmh(2).rel(1)

// Apply pass functions to patterns
var _chords1 = chordsPass(`<
 [0,2,4,7]
 [0,3,5,7]
 [1,3,5,7]
 [2,4,6,7]
>`).arp("<[0,1,2,3] [- [0,1] -[2,3]]>")

var _chords4 = chordsPass(`<
 [9 4 0 4 9 4 9 4 ]
 [10 5 1 5 10 5 10 5]
 [11 9 7 9 12 8# 6 8#]
 [9 6 4 6 8 6 4 6]
>`)

var _bass1 = bassPass(`<
 [2 2 3 2]*2
 [0 0 1 0]*2
 [4 4 5 4]*2
 [1 1 2 1]*2
>`)
var _bass2 = bassPass(`<
 [2 2 3 2]*2
 [0 0 1 0]*2
 [4 4 5 4 6 6 7 6]
 [5 5 6 5]*2
>`)
var _bbass1 = bbassPass(`<
 [- 0 - 1 - - 0 -]
 [- 0 - 2 - - -1 -]
 [- 0 - 3 - - 0 -]
 [- 0 - 2 - - -1 -]
>`)
var _bbass2 = bbassPass(`<
 [- 0 - 1 - - 0 -]
 [- 0 - 2 - - - -]
 [- 0 - 4 - - 0 -]
 [- 0 - 2 - - - -]
>`)



var _lead1 = leadPass(`<
 [- 7 _ 6 _  - [4 9] _ ] -
 [- 10 _ 9 _ - [5 4] _] -
>`)
var _lead2 = leadPass(`<
 [- 7 _ 6 7 4 2 4]
 [- 6# _ 6 _ 4 _ -]
 [- 5 _ 4 5 7 - 4]
 [- 3 _ 2 _ 1# _ 0]
 [- 7 _ 6 7 4 2 4]
 [- 8 _ 7 8 7 9 -]
 [10 9 7 4 2 4 7 9]
 [- 3 _ 2 _ 1# _ 0]
>`)
var _lead3 = leadPass(`<
 - [0,5 1 1 2]
 - [0,4 1 1 -]
 - [0,3 1 1 2]
 - [0,2 1 1 -]
>`)

var _wiss1 = wissPass(`<
 [7 _ 6 _ - - - -]
 [3 _ 2 _ - - - -]
>`)
var _wiss2 = wissPass(`<
 - - [3 4 4 3 5 6 6 5] -
 - - [3 4 4 3 7 5 5 7] -
>`).clip(.3).rel(.1)
var _wiss3 = wissPass(`<
 - - - [- - 5 - 6 - 7 - ]
>`)

var _chords6 = chordsPass(`<
 [[7,9]!3 -@5] [-@4 [7,9]!3 -] 
>`)
var _bass6 = bassPass(`<
 [-@5 [0,2]!3 ] -
>`)

var M = 1; 
// M = 0;
$: arrange(
  [M*2, stack(    
    _bbass1.distort(1.5),
  )],
  [M*4, stack(    
    // _drums_intro,
    _bass1,    _bbass1.distort(.8),
    _wiss1.mask("<~ ~ 1 1>").gain(.2).clip(.5),
  )],
  [M*8, stack(    
    // _drums1, d2xx,    
    _bass1,    _bbass1, _bbass1.trans(12).late(1/16).gain(.2),
  )],
  [M*8, stack(
    // _drums1.lpf(500),
    _chords1,     _bass1,    _bbass1,    _wiss2,
  )],
  [M*8, stack(
    // _drums1,    
    _chords1,     _bass1,    _bbass1,    _lead1,
  )],
  [M*8, stack(
    // _drums1,
    _chords1.trans(-12), 
    _bass1,    _bbass1,
    _lead1.hpf(1500).room(1.5),
    _lead2,
    _wiss3,
  )],
  [M*2, stack(    // break down
    _bbass1,
  )],
  [M*8, stack(
    // _drums2,
    _chords1.trans(-12).s("piano"), 
    _bass1.trans(12),
    _lead3,
  )],  
  [M*8, stack(
    // _drums1,    
    _chords1,     _bass1,        _bbass1,    _lead1,    _lead2,
  )],
  [M*8, stack(
    // _drums3,    
    _chords4, 
    _bass2,        _bass2.trans(12).late(1/16),    
    _bbass2,    _bbass2.trans(12).late(1/8),
  )],
  [M*8, stack(
    // _drums1, d7,
    _bass1.s("steinway").trans(24).gain(.4),    
    _lead1.trans(-12),
    _lead2,
  )],
  [M*2, stack(
    _drums_outro,
    _bass6,    _chords6,    
  )],
  

  [1*1, silence],
  ).punchcard()
  